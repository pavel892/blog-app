<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Create Post | Blog App</title>
  </head>

  <body>
    <div class="page-shell">
      <header class="site-header">
        <div class="hero-art">
          <img src="/images/controller.png" alt="" class="hero-controller" />

          <img src="/images/moon-and-stars.png" alt="" class="hero-moon" />

          <img src="/images/sleeping-cat.png" alt="" class="hero-cat" />
        </div>

        <div class="brand">
          <h1>Blog App</h1>
          <p>Create your next adventure</p>
        </div>

        <nav class="main-nav">
          <a href="/" class="nav-link"> <span>⌂</span> Home </a>

          <a href="/posts/new" class="nav-link active">
            <span>✎</span> Create Post
          </a>
        </nav>
      </header>

      <main class="create-main">
        <div class="section-heading">
          <span class="heading-star">★</span>
          <h2>New post</h2>
          <span class="heading-line"></span>
        </div>

        <section class="create-card">
          <div class="create-decoration">
            <img src="/images/handheld-console.png" alt="Retro game console" />
          </div>

          <div class="form-header">
            <span class="level-label">NEW LEVEL UNLOCKED</span>
            <h3>Write your story</h3>
          </div>

          <form action="/posts" method="POST" class="post-form">
            <div class="form-group">
              <label for="title">Post title</label>
              <input
                type="text"
                name="title"
                id="title"
                placeholder="Enter your title..."
                required
              />
            </div>

            <div class="form-group">
              <label for="content">Your story</label>
              <textarea
                name="content"
                id="content"
                rows="10"
                placeholder="Start writing your story..."
                required
              ></textarea>
            </div>

            <div class="form-actions">
              <a href="/" class="cancel-button">Cancel</a>
              <button type="submit" class="submit-button">
                <span>★</span> Publish Post
              </button>
            </div>
          </form>
        </section>
      </main>

      <footer class="site-footer">
        <span>PRESS START</span>
        <span class="footer-hearts">♥ ♥ ♥</span>
      </footer>
    </div>
  </body>
</html>
