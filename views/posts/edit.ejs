<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Edit Post | Pixel Blog</title>
  </head>

  <body>
    <header class="brand">
      <img
        src="/images/controller.png"
        alt="Pixel controller"
        class="hero-controller"
      />

      <img
        src="/images/moon-and-stars.png"
        alt="Moon and stars"
        class="hero-moon"
      />

      <img
        src="/images/sleeping-cat.png"
        alt="Sleeping pixel cat"
        class="hero-cat"
      />

      <h1>Pixel Blog</h1>
      <p class="brand-subtitle">Your little corner of the internet</p>
    </header>

    <nav class="main-nav">
      <a href="/">Home</a>
      <a href="/posts/new">Create Post</a>
    </nav>

    <main class="create-main">
      <section class="create-card">
        <div class="form-header">
          <span class="level-label">LEVEL: EDIT</span>
          <h2>Edit Post</h2>
          <p>Update your adventure...</p>
        </div>

        <form
          action="/posts/<%= post.id %>?_method=PATCH"
          method="POST"
          class="post-form"
        >
          <div class="form-group">
            <label for="title">Post title</label>

            <input
              type="text"
              id="title"
              name="title"
              value="<%= post.title %>"
              required
            />
          </div>

          <div class="form-group">
            <label for="content">Post content</label>

            <textarea id="content" name="content" rows="8" required>
<%= post.content %></textarea
            >
          </div>

          <div class="form-actions">
            <a href="/posts/<%= post.id %>" class="cancel-button"> Cancel </a>

            <button type="submit" class="submit-button">Save Changes</button>
          </div>
        </form>

        <img
          src="/images/stars-hearts-coins.png"
          alt=""
          class="create-decoration"
        />
      </section>
    </main>

    <footer>
      <p>PRESS START TO CONTINUE</p>
    </footer>
  </body>
</html>
